# Athena environment template.
# Copy to `.env` (git-ignored) and fill real values. NEVER commit secrets.
# All outbound endpoints are allowlisted and resolved by the orchestrator;
# specialists never receive raw credentials or select arbitrary destinations.

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
ATHENA_ENV=development            # development | demo | production
ATHENA_LOG_LEVEL=INFO
ATHENA_HOST=127.0.0.1
ATHENA_PORT=8000

# ---------------------------------------------------------------------------
# Heartbeat + investigation budgets
# ---------------------------------------------------------------------------
ATHENA_HEARTBEAT_INTERVAL_SECONDS=30
ATHENA_MAX_SPECIALISTS=2
ATHENA_MAX_TOTAL_TOKENS=14000
ATHENA_INVESTIGATION_DEADLINE_SECONDS=75

# ---------------------------------------------------------------------------
# Inference — real vLLM (OpenAI-compatible). Strategic = Nemotron-Super,
# Council specialist = Nemotron-Nano. Fill base URLs + model IDs for live runs.
# ---------------------------------------------------------------------------
ATHENA_MAIN_MODEL_BASE_URL=            # e.g. https://<gpu-host>:8000/v1
ATHENA_MAIN_MODEL_ID=                  # e.g. nvidia/llama-3.1-nemotron-super-49b-v1
ATHENA_MAIN_MODEL_API_KEY=             # if the endpoint requires a key
ATHENA_COUNCIL_MODEL_BASE_URL=         # e.g. https://<gpu-host>:8001/v1
ATHENA_COUNCIL_MODEL_ID=               # e.g. nvidia/nemotron-nano-9b
ATHENA_COUNCIL_MODEL_API_KEY=
ATHENA_INFERENCE_MODE=live             # live | mock  (mock used for reset/replay tests)

# Sanitized dev-only fallback. Disabled unless explicitly opted in.
ATHENA_FALLBACK_ENABLED=false
ATHENA_FALLBACK_MODEL_BASE_URL=
ATHENA_FALLBACK_MODEL_API_KEY=

# ---------------------------------------------------------------------------
# Runtime security — real HiddenLayer + NVIDIA OpenShell.
# HiddenLayer answers "should this interaction be trusted?"; OpenShell answers
# "can this action cross the protected boundary?". Kept independent by design.
#
# HiddenLayer uses the `hiddenlayer` Python SDK with OAuth2 client credentials.
# Generate a Client ID + Secret in the HiddenLayer console. The SDK exchanges
# them for a bearer token at ATHENA_SECURITY_AUTH_URL, then calls
# client.interactions.analyze(...) for runtime prompt/response inspection.
# ---------------------------------------------------------------------------
ATHENA_SECURITY_MODE=live              # live | mock
ATHENA_SECURITY_ENVIRONMENT=prod-us    # prod-us | prod-eu | self-hosted
ATHENA_SECURITY_CLIENT_ID=             # HiddenLayer OAuth2 client id
ATHENA_SECURITY_CLIENT_SECRET=         # HiddenLayer OAuth2 client secret
ATHENA_SECURITY_AUTH_URL=              # optional override (default https://auth.hiddenlayer.ai)
ATHENA_SECURITY_BASE_URL=              # optional: self-hosted AISec API base URL
ATHENA_SECURITY_TOKEN=                 # optional bearer-token fallback (instead of client id/secret)
ATHENA_SECURITY_FAIL_CLOSED=true       # fail closed for tool calls + persistent writes
ATHENA_OPENSHELL_POLICY_PATH=policies/openshell.yaml

# ---------------------------------------------------------------------------
# Telemetry sources (read-only). Fixtures used unless live URLs are provided.
# ---------------------------------------------------------------------------
ATHENA_PROMETHEUS_BASE_URL=
ATHENA_KUBERNETES_MODE=fixture         # fixture | live_read_only

# ---------------------------------------------------------------------------
# Durable state
# ---------------------------------------------------------------------------
ATHENA_STATE_DB_PATH=.athena/athena.db
