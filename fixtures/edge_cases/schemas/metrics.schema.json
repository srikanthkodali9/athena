{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.local/schemas/metrics.schema.json",
  "title": "Athena synthetic metric-series fixture",
  "type": "object",
  "required": ["schema_version", "dataset_id", "incident_id", "source", "series"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_id": {"type": "string"},
    "incident_id": {"type": "string", "pattern": "^inc_"},
    "source": {"const": "prometheus_fixture"},
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "metric", "labels", "unit", "points"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^metric_"},
          "metric": {"type": "string"},
          "labels": {"type": "object"},
          "unit": {"type": "string"},
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["timestamp", "value"],
              "properties": {
                "timestamp": {"type": "string", "format": "date-time"},
                "value": {"type": "number"}
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
